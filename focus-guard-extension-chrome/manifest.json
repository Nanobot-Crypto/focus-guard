{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.0",
  "description": "Env\u00eda URLs al daemon Focus Guard para detecci\u00f3n de distracciones",
  "permissions": [
    "tabs",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:37291/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}